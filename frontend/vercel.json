{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://lawmithra.onrender.com/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://lawmithra.onrender.com/api/"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://lawmithra.onrender.com/media/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
